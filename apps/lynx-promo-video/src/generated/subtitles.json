  "en": [
    {
      "sceneId": "hook",
      "from": 3,
      "to": 105,
      "text": "You can write Tailwind CSS directly in Lynx."
    },
    {
      "sceneId": "config",
      "from": 153,
      "to": 320,
      "text": "@weapp-tailwindcss/lynx brings Tailwind CSS 4 to ReactLynx and Rspeedy."
    },
    {
      "sceneId": "classname",
      "from": 393,
      "to": 455,
      "text": "Here is the real editor."
    },
    {
      "sceneId": "classname",
      "from": 456,
      "to": 559,
      "text": "First, change the spacing and corner radius."
    },
    {
      "sceneId": "classname",
      "from": 663,
      "to": 760,
      "text": "Save, build, and check the native result."
    },
    {
      "sceneId": "classname",
      "from": 843,
      "to": 937,
      "text": "Then change the background color and build again."
    },
    {
      "sceneId": "classname",
      "from": 1083,
      "to": 1182,
      "text": "Every change you see comes from the actual component."
    },
    {
      "sceneId": "pipeline",
      "from": 1293,
      "to": 1421,
      "text": "Styles become CSS at build time and enter the native bundle."
    },
    {
      "sceneId": "native",
      "from": 1473,
      "to": 1602,
      "text": "The same component code runs natively on iOS and Android."
    },
    {
      "sceneId": "evidence",
      "from": 1833,
      "to": 1978,
      "text": "From generation and encoding to native runtime, every boundary has evidence."
    },
    {
      "sceneId": "cta",
      "from": 2103,
      "to": 2203,
      "text": "Open the Lynx integration docs and start building."
    }
  ]
}
