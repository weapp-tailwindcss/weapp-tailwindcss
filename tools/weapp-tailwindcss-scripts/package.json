{
  "name": "@weapp-tailwindcss/scripts",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Internal build scripts for the cross-platform weapp-tailwindcss workspace. weapp-tailwindcss 跨端工作区的内部构建脚本。",
  "scripts": {
    "build:css": "tsx src/build-css.ts",
    "build:weapp-theme": "tsx src/build-weapp-theme.ts",
    "build:types": "tsx src/rewrite-dts-aliases.ts && tsx src/create-entry-dts.ts",
    "ensure-escape-dts": "tsx src/ensure-escape-dts.ts",
    "bench:vite-perf": "tsx src/vite-perf-bench.ts",
    "bench:vite-perf:summary": "tsx src/vite-perf-summary.ts",
    "bench:js-handlers": "tsx src/js-bench.ts",
    "bench:js-diff": "tsx src/js-bench-diff.ts",
    "clean:core": "tsx src/clean.ts",
    "get-decl": "tsx src/get-decl.ts",
    "colors": "tsx src/colors.ts",
    "release": "tsx src/release.ts",
    "bench:vite-dev-hmr": "tsx src/vite-dev-hmr-bench.ts",
    "watch-hmr:speed-report": "node ../../.github/scripts/e2e-watch-report.cjs speed-report",
    "test:watch-hmr": "node --import tsx src/watch-hmr-regression/index.ts"
  },
  "dependencies": {
    "@csstools/css-color-parser": "catalog:csstools",
    "@csstools/css-parser-algorithms": "catalog:csstools",
    "@csstools/css-tokenizer": "catalog:csstools",
    "@weapp-tailwindcss/escape": "workspace:~",
    "colorette": "^2.0.20",
    "del": "catalog:tooling",
    "execa": "catalog:tooling",
    "fast-glob": "catalog:buildUtilities",
    "fs-extra": "catalog:buildUtilities",
    "lightningcss": "^1.33.0",
    "pathe": "catalog:buildUtilities",
    "picocolors": "catalog:buildUtilities",
    "postcss": "catalog:postcss85",
    "tailwindcss": "catalog:tailwindcss4",
    "traverse": "catalog:tooling"
  },
  "devDependencies": {
    "@types/node": "catalog:typesNode2410",
    "playwright": "^1.63.0",
    "tsx": "catalog:tsx",
    "typescript": "catalog:typescript59"
  }
}
