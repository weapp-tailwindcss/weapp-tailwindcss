{
  "name": "@weapp-tailwindcss/postcss",
  "type": "module",
  "version": "4.0.4",
  "description": "PostCSS transforms that bring Tailwind CSS compatibility to every platform. 将 Tailwind CSS 兼容能力带到全端的 PostCSS 转换工具。",
  "author": "ice breaker <1324318532@qq.com>",
  "license": "MIT",
  "homepage": "https://tw.weapp.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weapp-tailwindcss/weapp-tailwindcss.git",
    "directory": "packages/postcss"
  },
  "bugs": {
    "url": "https://github.com/weapp-tailwindcss/weapp-tailwindcss/issues"
  },
  "keywords": [],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/types.d.ts",
        "default": "./dist/types.js"
      },
      "require": {
        "types": "./dist/types.d.cts",
        "default": "./dist/types.cjs"
      }
    },
    "./html-transform": {
      "import": {
        "types": "./dist/html-transform.d.ts",
        "default": "./dist/html-transform.js"
      },
      "require": {
        "types": "./dist/html-transform.d.cts",
        "default": "./dist/html-transform.cjs"
      }
    },
    "./css-macro/postcss": {
      "import": {
        "types": "./dist/css-macro/postcss.d.ts",
        "default": "./dist/css-macro/postcss.js"
      },
      "require": {
        "types": "./dist/css-macro/postcss.d.cts",
        "default": "./dist/css-macro/postcss.cjs"
      }
    },
    "./package.json": "./package.json",
    "./native": {
      "import": {
        "types": "./dist/native.d.ts",
        "default": "./dist/native.js"
      },
      "require": {
        "types": "./dist/native.d.cts",
        "default": "./dist/native.cjs"
      }
    },
    "./experimental/lightningcss": {
      "import": {
        "types": "./dist/experimental/lightningcss/index.d.ts",
        "default": "./dist/experimental/lightningcss/index.js"
      },
      "require": {
        "types": "./dist/experimental/lightningcss/index.d.cts",
        "default": "./dist/experimental/lightningcss/index.cjs"
      }
    },
    "./syntax": {
      "import": {
        "types": "./dist/syntax.d.ts",
        "default": "./dist/syntax.js"
      },
      "require": {
        "types": "./dist/syntax.d.cts",
        "default": "./dist/syntax.cjs"
      }
    },
    "./transform": {
      "import": {
        "types": "./dist/transform.d.ts",
        "default": "./dist/transform.js"
      },
      "require": {
        "types": "./dist/transform.d.cts",
        "default": "./dist/transform.cjs"
      }
    },
    "./plugin": {
      "import": {
        "types": "./dist/plugin.d.ts",
        "default": "./dist/plugin.js"
      },
      "require": {
        "types": "./dist/plugin.d.cts",
        "default": "./dist/plugin.cjs"
      }
    },
    "./native-runtime": {
      "import": {
        "types": "./dist/native-runtime.d.ts",
        "default": "./dist/native-runtime.js"
      },
      "require": {
        "types": "./dist/native-runtime.d.cts",
        "default": "./dist/native-runtime.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "html-transform": [
        "./dist/html-transform.d.ts"
      ],
      "css-macro/postcss": [
        "./dist/css-macro/postcss.d.ts"
      ],
      "types": [
        "./dist/types.d.ts"
      ],
      "*": [
        "./dist/*",
        "./dist/index.d.ts"
      ],
      "native": [
        "./dist/native.d.ts"
      ],
      "experimental/lightningcss": [
        "./dist/experimental/lightningcss/index.d.ts"
      ],
      "native-runtime": [
        "./dist/native-runtime.d.ts"
      ]
    }
  },
  "files": [
    "THIRD_PARTY_LICENSES.txt",
    "dist"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "tsdown --watch --sourcemap",
    "build": "tsdown && pnpm build:types",
    "build:types": "tsc -p tsconfig.build.json && tsx ../../tools/weapp-tailwindcss-scripts/src/rewrite-dts-aliases.ts . && tsx ../../tools/weapp-tailwindcss-scripts/src/duplicate-cjs-declarations.ts . --default=html-transform",
    "build:native": "node native/build.mjs",
    "test": "vitest run",
    "bench": "vitest bench",
    "test:dev": "vitest",
    "release": "pnpm publish",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "peerDependencies": {
    "lightningcss": "^1.33.0"
  },
  "peerDependenciesMeta": {
    "lightningcss": {
      "optional": true
    }
  },
  "dependencies": {
    "@csstools/css-color-parser": "catalog:csstools",
    "@csstools/css-parser-algorithms": "catalog:csstools",
    "@csstools/css-tokenizer": "catalog:csstools",
    "@weapp-tailwindcss/css-compat": "workspace:*",
    "@weapp-tailwindcss/engine": "workspace:*",
    "@weapp-tailwindcss/escape": "workspace:*",
    "@weapp-tailwindcss/postcss-calc": "workspace:*",
    "@weapp-tailwindcss/shared": "workspace:*",
    "@weapp-tailwindcss/source-scan": "workspace:*",
    "autoprefixer": "catalog:autoprefixer10",
    "lru-cache": "catalog:buildUtilities",
    "postcss": "catalog:postcss85tilde",
    "postcss-load-config": "catalog:buildUtilities",
    "postcss-preset-env": "catalog:postcssUtilities",
    "postcss-pxtrans": "catalog:postcssCompat",
    "postcss-rem-to-responsive-pixel": "catalog:postcssRem",
    "postcss-rule-unit-converter": "catalog:postcssCompat",
    "postcss-scss": "catalog:postcssCompat",
    "postcss-selector-parser": "catalog:buildUtilities",
    "postcss-value-parser": "catalog:postcssCompat",
    "tailwindcss-config": "workspace:*"
  },
  "optionalDependencies": {
    "@weapp-tailwindcss/native-darwin-arm64": "workspace:*",
    "@weapp-tailwindcss/native-darwin-x64": "workspace:*",
    "@weapp-tailwindcss/native-linux-arm64-gnu": "workspace:*",
    "@weapp-tailwindcss/native-linux-arm64-musl": "workspace:*",
    "@weapp-tailwindcss/native-linux-x64-gnu": "workspace:*",
    "@weapp-tailwindcss/native-linux-x64-musl": "workspace:*",
    "@weapp-tailwindcss/native-win32-arm64-msvc": "workspace:*",
    "@weapp-tailwindcss/native-win32-x64-msvc": "workspace:*"
  },
  "devDependencies": {
    "@csstools/postcss-is-pseudo-class": "^6.0.3",
    "fast-check": "^4.10.2",
    "lightningcss": "^1.33.0",
    "postcss-custom-properties": "^15.0.4",
    "tsx": "catalog:tsx"
  }
}
