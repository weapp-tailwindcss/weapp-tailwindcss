// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`compose > components 0 1`] = `
"@layer properties;
*,:after,:before,::backdrop {
  box-sizing: border-box;
  border: 0 solid;
  margin: 0;
  padding: 0;
}
@layer components {
  .btn-primary {
    border-radius: var(--radius-sm);
    padding-block: calc(var(--spacing) * 4);
    text-align: center;
    font-family: var(--font-sans);
    --tw-font-weight: var(--font-weight-medium);
    font-weight: var(--font-weight-medium);
    color: var(--color-white);
  }
}
@property --tw-font-weight {
  syntax: "*";
  inherits: false;
}
@layer properties {
  @supports ((-webkit-hyphens: none) and (not (margin-trim: block))) or ((-moz-orient: inline) and (not (color:rgb(from red r g b)))) {
    *, ::before, ::after, ::backdrop {
      --tw-font-weight: initial;
    }
  }
}
"
`;

exports[`compose > components 0 2`] = `
"
    view,text,::before,::after {
      --tw-font-weight: initial;
    }
view,text,::after,::before {
  box-sizing: border-box;
  border: 0 solid;
  margin: 0;
  padding: 0;
}
  .btn-primary {
    border-radius: var(--radius-sm);
    padding-top: calc(var(--spacing) * 4);
    padding-bottom: calc(var(--spacing) * 4);
    text-align: center;
    font-family: var(--font-sans);
    --tw-font-weight: var(--font-weight-medium);
    font-weight: var(--font-weight-medium);
    color: var(--color-white);
  }
"
`;

