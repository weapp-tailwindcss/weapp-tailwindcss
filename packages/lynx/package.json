{
  "name": "@weapp-tailwindcss/lynx",
  "type": "module",
  "version": "0.5.0",
  "description": "Tailwind CSS integration for ReactLynx and Rspeedy cross-platform builds. 面向 ReactLynx 与 Rspeedy 跨端构建的 Tailwind CSS 集成。",
  "license": "MIT",
  "homepage": "https://tw.weapp.dev/docs/quick-start/frameworks/lynx",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weapp-tailwindcss/weapp-tailwindcss.git",
    "directory": "packages/lynx"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json",
    "./decoder": {
      "types": "./dist/decoder.d.ts",
      "import": "./dist/decoder.js",
      "require": "./dist/decoder.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "build": "tsdown",
    "test": "node ../../scripts/ensure-weapp-tailwindcss-built.mjs && vitest run",
    "test:dev": "node ../../scripts/ensure-weapp-tailwindcss-built.mjs && vitest",
    "lint": "eslint .",
    "release": "pnpm publish"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@lynx-js/react-rsbuild-plugin": ">=0.12.4",
    "@lynx-js/rspeedy": ">=0.16.0",
    "tailwindcss": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@lynx-js/react-rsbuild-plugin": {
      "optional": true
    },
    "@lynx-js/rspeedy": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "weapp-tailwindcss": "workspace:*"
  },
  "devDependencies": {
    "@lynx-js/rspeedy": "^0.18.3",
    "tailwindcss": "catalog:tailwindcss4",
    "vitest": "catalog:vitest"
  }
}
