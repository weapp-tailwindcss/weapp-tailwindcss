{
  "name": "@weapp-tailwindcss/react-native",
  "type": "module",
  "version": "0.3.7",
  "description": "Tailwind CSS compiler and Expo Metro integration for cross-platform React Native apps. 面向跨端 React Native 应用的 Tailwind CSS 编译器与 Expo Metro 集成。",
  "license": "MIT",
  "homepage": "https://tw.weapp.dev/docs/quick-start/react-native-expo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weapp-tailwindcss/weapp-tailwindcss.git",
    "directory": "packages/react-native"
  },
  "sideEffects": true,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./compiler": {
      "import": {
        "types": "./dist/compiler.d.ts",
        "default": "./dist/compiler.js"
      },
      "require": {
        "types": "./dist/compiler.d.cts",
        "default": "./dist/compiler.cjs"
      }
    },
    "./tailwind": {
      "import": {
        "types": "./dist/tailwind.d.ts",
        "default": "./dist/tailwind.js"
      },
      "require": {
        "types": "./dist/tailwind.d.cts",
        "default": "./dist/tailwind.cjs"
      }
    },
    "./babel": {
      "import": {
        "types": "./dist/babel.d.ts",
        "default": "./dist/babel.js"
      },
      "require": {
        "types": "./dist/babel.d.cts",
        "default": "./dist/babel.cjs"
      }
    },
    "./metro": {
      "import": {
        "types": "./dist/metro.d.ts",
        "default": "./dist/metro.js"
      },
      "require": {
        "types": "./dist/metro.d.cts",
        "default": "./dist/metro.cjs"
      }
    },
    "./runtime": {
      "import": {
        "types": "./dist/runtime.d.ts",
        "default": "./dist/runtime.js"
      },
      "require": {
        "types": "./dist/runtime.d.cts",
        "default": "./dist/runtime.cjs"
      }
    },
    "./env": {
      "import": {
        "types": "./dist/env.d.ts",
        "default": "./dist/env.js"
      },
      "require": {
        "types": "./dist/env.d.cts",
        "default": "./dist/env.cjs"
      }
    },
    "./metro-transformer": {
      "import": {
        "types": "./dist/metro-transformer.d.ts",
        "default": "./dist/metro-transformer.js"
      },
      "require": {
        "types": "./dist/metro-transformer.d.cts",
        "default": "./dist/metro-transformer.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsdown && tsx ../../tools/weapp-tailwindcss-scripts/src/duplicate-cjs-declarations.ts . --only-defaults --default=babel",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json --pretty false",
    "bench": "vitest bench",
    "test:dev": "vitest",
    "lint": "eslint .",
    "release": "pnpm publish"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@babel/core": ">=7.22.0",
    "expo": ">=54.0.0",
    "react": ">=19.0.0",
    "react-native": ">=0.81.0",
    "tailwindcss": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@babel/core": {
      "optional": true
    },
    "expo": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "dependencies": {
    "@babel/types": "catalog:babel8",
    "@types/convert-source-map": "^2.0.3",
    "@weapp-tailwindcss/postcss": "workspace:*",
    "weapp-tailwindcss": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "catalog:babelCore7285",
    "@types/react": "catalog:react19",
    "react": "catalog:react19",
    "typescript": "^5.9.3",
    "vitest": "catalog:vitest"
  }
}
