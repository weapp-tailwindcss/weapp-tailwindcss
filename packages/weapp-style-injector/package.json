{
  "name": "weapp-style-injector",
  "type": "module",
  "version": "1.0.9",
  "description": "Style entry injection for cross-platform mini-program and Web builds. 面向小程序与 Web 跨端构建的样式入口注入工具。",
  "author": "ice breaker <1324318532@qq.com>",
  "license": "MIT",
  "homepage": "https://tw.weapp.dev/docs/quick-start/independent-pkg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weapp-tailwindcss/weapp-tailwindcss.git",
    "directory": "packages/weapp-style-injector"
  },
  "bugs": {
    "url": "https://github.com/weapp-tailwindcss/weapp-tailwindcss/issues"
  },
  "keywords": [],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./vite": {
      "import": {
        "types": "./dist/vite.d.ts",
        "default": "./dist/vite.js"
      },
      "require": {
        "types": "./dist/vite.d.cts",
        "default": "./dist/vite.cjs"
      }
    },
    "./vite/uni-app": {
      "import": {
        "types": "./dist/vite/uni-app.d.ts",
        "default": "./dist/vite/uni-app.js"
      },
      "require": {
        "types": "./dist/vite/uni-app.d.cts",
        "default": "./dist/vite/uni-app.cjs"
      }
    },
    "./vite/taro": {
      "import": {
        "types": "./dist/vite/taro.d.ts",
        "default": "./dist/vite/taro.js"
      },
      "require": {
        "types": "./dist/vite/taro.d.cts",
        "default": "./dist/vite/taro.cjs"
      }
    },
    "./webpack": {
      "import": {
        "types": "./dist/webpack.d.ts",
        "default": "./dist/webpack.js"
      },
      "require": {
        "types": "./dist/webpack.d.cts",
        "default": "./dist/webpack.cjs"
      }
    },
    "./webpack/uni-app": {
      "import": {
        "types": "./dist/webpack/uni-app.d.ts",
        "default": "./dist/webpack/uni-app.js"
      },
      "require": {
        "types": "./dist/webpack/uni-app.d.cts",
        "default": "./dist/webpack/uni-app.cjs"
      }
    },
    "./webpack/taro": {
      "import": {
        "types": "./dist/webpack/taro.d.ts",
        "default": "./dist/webpack/taro.js"
      },
      "require": {
        "types": "./dist/webpack/taro.d.cts",
        "default": "./dist/webpack/taro.cjs"
      }
    },
    "./webpack/mpx": {
      "import": {
        "types": "./dist/webpack/mpx.d.ts",
        "default": "./dist/webpack/mpx.js"
      },
      "require": {
        "types": "./dist/webpack/mpx.d.cts",
        "default": "./dist/webpack/mpx.cjs"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/types.d.ts",
        "default": "./dist/types.js"
      },
      "require": {
        "types": "./dist/types.d.cts",
        "default": "./dist/types.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "tsdown --watch --sourcemap",
    "build": "tsdown && pnpm build:types",
    "build:types": "tsc -p tsconfig.build.json && tsx ../../tools/weapp-tailwindcss-scripts/src/rewrite-dts-aliases.ts . && tsx ../../tools/weapp-tailwindcss-scripts/src/duplicate-cjs-declarations.ts .",
    "test": "vitest run",
    "test:dev": "vitest",
    "release": "pnpm publish",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "peerDependencies": {
    "vite": "^5.2.0 || ^6.0.0 || ^7.0.0 || ^8.0.0",
    "webpack": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "webpack": {
      "optional": true
    }
  },
  "dependencies": {
    "@weapp-tailwindcss/shared": "workspace:*",
    "micromatch": "catalog:buildUtilities"
  },
  "devDependencies": {
    "tsx": "catalog:tsx"
  },
  "publishConfig": {}
}
