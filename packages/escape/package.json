{
  "name": "@weapp-tailwindcss/escape",
  "type": "module",
  "version": "0.0.1",
  "description": "escape class name in weapp",
  "author": "ice breaker <1324318532@qq.com>",
  "license": "MIT",
  "homepage": "https://tw.weapp.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weapp-tailwindcss/weapp-tailwindcss.git",
    "directory": "packages/escape"
  },
  "bugs": {
    "url": "https://github.com/weapp-tailwindcss/weapp-tailwindcss/issues"
  },
  "keywords": [
    "weapp",
    "escape",
    "css"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --update=none",
    "test:dev": "vitest",
    "test:types": "tsdown && tsd --files test/types.test-d.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "tsd": "tsd --files test/types.test-d.ts",
    "lint": "eslint .",
    "test:package": "node scripts/verify-package.mjs",
    "bench": "vitest bench --run"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {},
  "devDependencies": {
    "escape-published": "npm:@weapp-core/escape@8.0.0"
  }
}
