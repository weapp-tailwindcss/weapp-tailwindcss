{
  "name": "tailwindcss-injector",
  "type": "module",
  "version": "1.0.31",
  "description": "Tailwind CSS generation and source injection helpers for cross-platform builds. 跨端构建的 Tailwind CSS 生成与源码注入工具。",
  "author": "ice breaker <1324318532@qq.com>",
  "license": "MIT",
  "homepage": "https://tw.weapp.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weapp-tailwindcss/weapp-tailwindcss.git",
    "directory": "packages/tailwindcss-injector"
  },
  "bugs": {
    "url": "https://github.com/weapp-tailwindcss/weapp-tailwindcss/issues"
  },
  "keywords": [],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./postcss": {
      "import": {
        "types": "./dist/postcss.d.ts",
        "default": "./dist/postcss.js"
      },
      "require": {
        "types": "./dist/postcss.d.cts",
        "default": "./dist/postcss.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "tsdown --watch --sourcemap",
    "build": "tsdown && tsx ../../tools/weapp-tailwindcss-scripts/src/duplicate-cjs-declarations.ts . --only-defaults --default=postcss",
    "test": "vitest run",
    "test:dev": "vitest",
    "release": "pnpm publish",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./postcss": {
        "import": {
          "types": "./dist/postcss.d.ts",
          "default": "./dist/postcss.js"
        },
        "require": {
          "types": "./dist/postcss.d.cts",
          "default": "./dist/postcss.cjs"
        }
      }
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "dependencies": {
    "@weapp-tailwindcss/postcss": "workspace:*",
    "@weapp-tailwindcss/shared": "workspace:*",
    "fs-extra": "catalog:buildUtilities",
    "htmlparser2": "catalog:buildUtilities",
    "magic-string": "catalog:buildUtilities",
    "tailwindcss": "catalog:tailwindcss4",
    "tailwindcss-config": "workspace:*"
  }
}
