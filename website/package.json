{
  "name": "@weapp-tailwindcss/website",
  "version": "1.0.66",
  "private": true,
  "author": "ice breaker <1324318532@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weapp-tailwindcss/weapp-tailwindcss.git",
    "directory": "website"
  },
  "bugs": {
    "url": "https://github.com/weapp-tailwindcss/weapp-tailwindcss/issues"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "docusaurus": "cross-env NO_UPDATE_NOTIFIER=1 docusaurus",
    "dev": "pnpm run build:deps:if-needed && node scripts/dev-public.mjs",
    "dev:type": "cross-env NO_UPDATE_NOTIFIER=1 TYPEDOC_WATCH=true docusaurus start --port 4000",
    "build": "pnpm run check:config-docs && pnpm run check:docs-i18n && pnpm run build:deps && node scripts/clear-webpack-cache.mjs && node scripts/generate-geo-index.mjs && node scripts/redirects.mjs && node scripts/seo-quality-report.mjs && cross-env NO_UPDATE_NOTIFIER=1 docusaurus build",
    "build:deps": "node scripts/build-deps.mjs",
    "build:deps:if-needed": "node scripts/build-deps.mjs --if-needed",
    "check:docs-audience": "node scripts/check-docs-audience.mjs",
    "check:config-docs": "node scripts/check-config-docs.mjs",
    "build:next": "cross-env SITE_URL=https://next.tw.weapp.dev pnpm run build",
    "deploy:worker": "wrangler deploy --config wrangler.jsonc --env=\"\"",
    "deploy:worker:next": "wrangler deploy --config wrangler.jsonc --env next",
    "deploy:worker:dry-run": "wrangler deploy --config wrangler.jsonc --env=\"\" --dry-run",
    "swizzle": "cross-env NO_UPDATE_NOTIFIER=1 docusaurus swizzle",
    "clear": "cross-env NO_UPDATE_NOTIFIER=1 docusaurus clear",
    "serve": "cross-env NO_UPDATE_NOTIFIER=1 docusaurus serve",
    "serve:public": "cross-env NO_UPDATE_NOTIFIER=1 docusaurus serve --port 4000 --host 0.0.0.0",
    "write-translations": "cross-env NO_UPDATE_NOTIFIER=1 docusaurus write-translations",
    "write-heading-ids": "cross-env NO_UPDATE_NOTIFIER=1 docusaurus write-heading-ids",
    "typecheck": "tsc",
    "build:docs": "node scripts/index.js",
    "check:docs-i18n": "node scripts/check-docs-i18n.mjs",
    "seo:audit": "node scripts/seo-audit.mjs",
    "seo:audit:strict": "node scripts/seo-audit.mjs --strict",
    "seo:enrich": "node scripts/seo-enrich-frontmatter.mjs --write",
    "seo:keywords:normalize": "node scripts/seo-normalize-keywords.mjs --write",
    "seo:quality": "node scripts/seo-quality-check.mjs",
    "seo:quality:strict": "node scripts/seo-quality-check.mjs --strict",
    "seo:few-keywords": "node scripts/seo-quality-check.mjs --strict --only=few_keywords",
    "seo:quality:report": "node scripts/seo-quality-report.mjs",
    "geo:index": "node scripts/generate-geo-index.mjs",
    "verify:deployment": "tsx scripts/verify-deployment-assets.ts",
    "verify:domain-migration": "tsx scripts/verify-domain-migration.ts",
    "test:worker": "tsx scripts/verify-worker-local.ts",
    "e2e": "playwright test",
    "e2e:u": "playwright test -u",
    "exportRoutes": "tsx scripts/exportRoutes.ts"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/plugin-content-blog": "3.10.2",
    "@docusaurus/plugin-content-docs": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-live-codeblock": "3.10.2",
    "@mdx-js/react": "^3.1.1",
    "@weapp-tailwindcss/cva": "workspace:*",
    "@weapp-tailwindcss/merge": "workspace:*",
    "@weapp-tailwindcss/variants": "workspace:*",
    "clsx": "catalog:clsx",
    "file-saver": "^2.0.5",
    "pako": "^2.2.0",
    "prism-react-renderer": "^2.4.1",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "react-github-btn": "^1.4.0",
    "tailwind-merge": "catalog:tailwindMerge",
    "tailwind-variants": "^3.3.1",
    "weapp-tailwindcss": "workspace:*"
  },
  "devDependencies": {
    "@babel/parser": "~7.29.8",
    "@babel/traverse": "~7.29.8",
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/remark-plugin-npm2yarn": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@icebreakers/deploy": "^0.1.6",
    "@iconify-json/bi": "catalog:iconifyJson",
    "@iconify-json/line-md": "catalog:iconifyJson",
    "@iconify-json/logos": "catalog:iconifyJson",
    "@iconify-json/mdi": "catalog:iconifyJson",
    "@iconify-json/mdi-light": "catalog:iconifyJson",
    "@iconify/tailwind4": "^1.2.3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/file-saver": "^2.0.7",
    "@types/node": "catalog:typesNode2410",
    "@types/pako": "^2.0.4",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "autoprefixer": "catalog:autoprefixer10",
    "baseline-browser-mapping": "catalog:baselineBrowserMapping",
    "cross-env": "catalog:crossEnv",
    "docusaurus-plugin-llms": "^0.6.0",
    "docusaurus-plugin-sass": "^0.2.7",
    "docusaurus-plugin-typedoc": "1.4.3",
    "dotenv": "^17.4.2",
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.4.2",
    "mini-svg-data-uri": "^1.4.4",
    "node-loader": "^2.1.0",
    "sass": "catalog:sass195",
    "sass-loader": "^17.0.1",
    "tailwindcss": "catalog:tailwindcss4",
    "theme-transition": "workspace:*",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "4.13.0",
    "webpack": "5.105.4",
    "webpack-node-externals": "^3.0.0",
    "wrangler": "catalog:wrangler"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
