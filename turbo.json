{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": [
    "WEAPP_TW_SKIP_AUTO_BUILD",
    "WEAPP_TW_SKIP_INTERACTIVE_TARO_BUILD",
    "WEAPP_TW_SKIP_INTERACTIVE_UNI_BUILD",
    "TARO_BUILD_STRICT",
    "UNI_BUILD_STRICT"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "build/**",
        "result.css",
        "result.json",
        "transformed.css"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ],
      "outputs": []
    },
    "dev": {
      "cache": false
    },
    "test": {
      "dependsOn": [
        "^test"
      ],
      "outputs": [
        "coverage/**"
      ]
    },
    "tsd": {
      "dependsOn": [
        "^tsd"
      ],
      "outputs": []
    },
    "release": {},
    "sync": {
      "cache": false
    },
    "@weapp-tailwindcss-demo/web-nuxt-vite-tailwindcss-v4#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".output/**"
      ]
    },
    "@weapp-tailwindcss-demo/issue-951-taro-vite-react-tailwindcss-v4#build": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "@weapp-tailwindcss-demo/issue-uview-plus-cssentries#build": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "@weapp-tailwindcss-demo/style-injector-taro-vite-react#build": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "@weapp-tailwindcss-demo/style-injector-taro-webpack-react#build": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "@weapp-tailwindcss-demo/subpackage-taro-webpack-react-tailwindcss-v4#build": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "@weapp-tailwindcss-demo/subpackage-uni-app-vite-tailwindcss-v4#build": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "@weapp-tailwindcss-demo/taro-vite-react-tailwindcss-v4#build": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "@weapp-tailwindcss-demo/taro-vite-vue3-tailwindcss-v4#build": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "@weapp-tailwindcss-demo/taro-webpack-react-tailwindcss-v4#build": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "@weapp-tailwindcss-demo/taro-webpack-vue3-tailwindcss-v4#build": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "@weapp-tailwindcss-demo/uni-app-vite-tailwindcss-v4#build": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "@weapp-tailwindcss-demo/uni-app-vite-vue3-hbuilderx-tailwindcss-v4#build": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "demo/*#build": {
      "dependsOn": [
        "^build",
        "@weapp-tailwindcss/build-all#build"
      ],
      "outputs": [
        "dist/**",
        "build/**",
        "result.css",
        "result.json",
        "transformed.css"
      ]
    },
    "demo/web/*#build": {
      "dependsOn": [
        "^build",
        "@weapp-tailwindcss/build-all#build"
      ],
      "outputs": [
        "dist/**",
        "dist-web/**",
        "dist-weapp/**"
      ]
    },
    "apps/**#build": {
      "dependsOn": [
        "^build",
        "@weapp-tailwindcss/build-all#build"
      ],
      "outputs": [
        "dist/**",
        "build/**",
        "result.css",
        "result.json",
        "transformed.css"
      ]
    }
  },
  "boundaries": {
    "implicitDependencies": [
      "apps/* -> packages/*",
      "demo/* -> packages/*",
      "demo/web/* -> packages/*"
    ]
  }
}
