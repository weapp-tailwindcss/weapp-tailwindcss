source 'https://cdn.cocoapods.org/'
require_relative 'lynx-source-patch'

platform :ios, '15.0'

target 'LynxCompatibilityHost' do
  use_frameworks! :linkage => :static
  pod 'Lynx', '4.0.1', :subspecs => ['Framework']
  # 固定 Lynx 的传递依赖，避免 CocoaPods 为无约束依赖扫描 nightly podspec。
  pod 'LynxBase', '4.0.1', :subspecs => ['Framework']
  pod 'LynxServiceAPI', '4.0.1'
  pod 'PrimJS', '4.0.0', :subspecs => ['napi/env', 'napi/jsc', 'napi/quickjs', 'quickjs']
end

post_install do |installer|
  lynx = installer.pod_targets.find { |target| target.pod_name == 'Lynx' }
  raise '缺少受管 Lynx Pod' unless lynx
  LynxSourcePatch.apply!(installer.sandbox.pod_dir('Lynx'), lynx.root_spec.version)
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
      # Lynx 的旧 Podspec 仍声明 iOS 9/10；新 Xcode 已不再接受这些模拟器目标。
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
    next unless target.name == 'Lynx'
    # Lynx 4.0.1 的源文件仍将旧 SDK 弃用告警提升为错误；Xcode 26 的 UIKit 已扩大这组告警。
    target.source_build_phase.files.each do |file|
      settings = file.settings || {}
      flags = settings['COMPILER_FLAGS']
      if flags.is_a?(String)
        settings['COMPILER_FLAGS'] = "#{flags} -Wno-error=deprecated-declarations -Wno-error=deprecated-implementations -Wno-error=deprecated-objc-isa-usage"
      end
      file.settings = settings
    end
  end
end
