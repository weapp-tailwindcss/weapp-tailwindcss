	["dark:--theme-line", "#343943"],
	["dark:--theme-primary", "#6b8cff"],
	["dark:--theme-secondary", "#35d4d4"],
	["dark:--theme-on-primary", "#ffffff"],
	["ocean-light:--theme-page", "#f7f8fa"],
	["ocean-light:--theme-surface", "#ffffff"],
	["ocean-light:--theme-surface-muted", "#f1f3f5"],
	["ocean-light:--theme-content", "#1f2329"],
	["ocean-light:--theme-content-muted", "#646a73"],
	["ocean-light:--theme-line", "#dee0e3"],
	["ocean-light:--theme-primary", "#0f766e"],
	["ocean-light:--theme-secondary", "#0891b2"],
	["ocean-light:--theme-on-primary", "#ffffff"],
	["ocean-dark:--theme-page", "#181c23"],
	["ocean-dark:--theme-surface", "#1a1d23"],
	["ocean-dark:--theme-surface-muted", "#242830"],
	["ocean-dark:--theme-content", "#f2f3f5"],
	["ocean-dark:--theme-content-muted", "#a6aab2"],
	["ocean-dark:--theme-line", "#343943"],
	["ocean-dark:--theme-primary", "#2dd4bf"],
	["ocean-dark:--theme-secondary", "#38bdf8"],
	["ocean-dark:--theme-on-primary", "#ffffff"]
])

export function getThemeValue(name: string): ComputedRef<string> {
	return computed((): string => {
		const classValue = themeClassValues.get(theme.themeClass + ":" + name)
		if (classValue != null) return classValue
		const value = themeValues.get(name)
		if (value == null) {
			console.warn('未定义的主题变量：' + name)
			return ''
		}
		return value
	})
}
