	["light:--theme-on-primary", "#ffffff"],
	["dark:--theme-page", "#111318"],
	["dark:--theme-surface", "#1a1d23"],
	["dark:--theme-surface-muted", "#242830"],
	["dark:--theme-content", "#f2f3f5"],
