	["--radius-4xl", "32px"]
])

const themeClassValues: Map<string, string> = new Map<string, string>([
	["light:--theme-page", "#f7f8fa"],
	["light:--theme-surface", "#ffffff"],
	["light:--theme-surface-muted", "#f1f3f5"],
	["light:--theme-content", "#1f2329"],
	["light:--theme-content-muted", "#646a73"],
	["light:--theme-line", "#dee0e3"],
	["light:--theme-primary", "#3366ff"],
