{
  "name": "@weapp-tailwindcss/merge",
  "type": "module",
  "version": "2.2.7",
  "description": "Cross-platform Tailwind CSS class merging runtime with mini-program compatibility. 兼容小程序的跨端 Tailwind CSS 类名合并运行时。",
  "author": "ice breaker <1324318532@qq.com>",
  "license": "MIT",
  "homepage": "https://tw.weapp.dev/docs/community/merge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weapp-tailwindcss/weapp-tailwindcss.git",
    "directory": "packages-runtime/merge"
  },
  "bugs": {
    "url": "https://github.com/weapp-tailwindcss/weapp-tailwindcss/issues"
  },
  "keywords": [
    "tailwindcss",
    "merge",
    "mini-program",
    "runtime",
    "v4"
  ],
  "sideEffects": false,
  "_exports": {
    ".": "./src/index.ts",
    "./slim": "./src/slim.ts",
    "./lite": "./src/lite.ts"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./slim": {
      "import": {
        "types": "./dist/slim.d.mts",
        "default": "./dist/slim.mjs"
      },
      "require": {
        "types": "./dist/slim.d.cts",
        "default": "./dist/slim.cjs"
      }
    },
    "./lite": {
      "import": {
        "types": "./dist/lite.d.mts",
        "default": "./dist/lite.mjs"
      },
      "require": {
        "types": "./dist/lite.d.cts",
        "default": "./dist/lite.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "tsdown --watch --sourcemap",
    "build": "tsdown",
    "test": "vitest run",
    "test:dev": "vitest",
    "tsd": "tsd",
    "release": "pnpm publish",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.mts",
          "default": "./dist/index.mjs"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./slim": {
        "import": {
          "types": "./dist/slim.d.mts",
          "default": "./dist/slim.mjs"
        },
        "require": {
          "types": "./dist/slim.d.cts",
          "default": "./dist/slim.cjs"
        }
      },
      "./lite": {
        "import": {
          "types": "./dist/lite.d.mts",
          "default": "./dist/lite.mjs"
        },
        "require": {
          "types": "./dist/lite.d.cts",
          "default": "./dist/lite.cjs"
        }
      }
    },
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts"
  },
  "dependencies": {
    "@weapp-tailwindcss/escape": "workspace:*",
    "@weapp-tailwindcss/runtime": "workspace:*",
    "tailwind-merge": "catalog:tailwindMerge"
  },
  "devDependencies": {
    "fast-check": "^4.10.2"
  }
}
