{
  "name": "@weapp-tailwindcss/ui",
  "type": "module",
  "version": "0.0.20",
  "description": "Cross-platform utility-first UI components for Tailwind CSS. 面向跨端 Tailwind CSS 的 utility-first UI 组件库。",
  "author": "ice breaker <1324318532@qq.com>",
  "license": "ISC",
  "homepage": "https://tw.weapp.dev/docs/community/packages-runtime",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weapp-tailwindcss/weapp-tailwindcss.git",
    "directory": "packages-runtime/ui"
  },
  "bugs": {
    "url": "https://github.com/weapp-tailwindcss/weapp-tailwindcss/issues"
  },
  "keywords": [
    "tailwindcss",
    "mini-program",
    "ui",
    "components"
  ],
  "sideEffects": [
    "./dist/index.css",
    "./dist/index.wxss"
  ],
  "exports": {
    ".": "./dist/index.css",
    "./css": "./dist/index.css",
    "./index.css": "./dist/index.css",
    "./index.wxss": "./dist/index.wxss",
    "./variants": {
      "import": {
        "types": "./dist/variants.d.ts",
        "default": "./dist/variants.js"
      },
      "require": {
        "types": "./dist/variants.d.cts",
        "default": "./dist/variants.cjs"
      }
    },
    "./preset": {
      "import": {
        "types": "./dist/preset.d.ts",
        "default": "./dist/preset.js"
      },
      "require": {
        "types": "./dist/preset.d.cts",
        "default": "./dist/preset.cjs"
      }
    },
    "./components": {
      "import": {
        "types": "./dist/components/index.d.ts",
        "default": "./dist/components/index.js"
      },
      "require": {
        "types": "./dist/components/index.d.cts",
        "default": "./dist/components/index.cjs"
      }
    },
    "./utils": {
      "import": {
        "types": "./dist/utils/index.d.ts",
        "default": "./dist/utils/index.js"
      },
      "require": {
        "types": "./dist/utils/index.d.cts",
        "default": "./dist/utils/index.cjs"
      }
    },
    "./hooks": {
      "import": {
        "types": "./dist/hooks/index.d.ts",
        "default": "./dist/hooks/index.js"
      },
      "require": {
        "types": "./dist/hooks/index.d.cts",
        "default": "./dist/hooks/index.cjs"
      }
    },
    "./adapters": {
      "import": {
        "types": "./dist/adapters/index.d.ts",
        "default": "./dist/adapters/index.js"
      },
      "require": {
        "types": "./dist/adapters/index.d.cts",
        "default": "./dist/adapters/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "repoctl": {
    "packageCheck": {
      "runtimeAssets": ["./components"]
    }
  },
  "scripts": {
    "build": "vite build && tsdown",
    "build:watch": "tsdown --watch --on-success \"vite build --watch --emptyOutDir=false\"",
    "test": "vitest run",
    "test:dev": "vitest",
    "tsd": "tsd --typings dist/variants.d.ts --files test-d/variants.test-d.ts && tsd --typings dist/preset.d.ts --files test-d/preset.test-d.ts && tsd --typings dist/components/index.d.ts --files test-d/components.test-d.ts && tsd --typings dist/hooks/index.d.ts --files test-d/hooks.test-d.ts && tsd --typings dist/utils/index.d.ts --files test-d/utils.test-d.ts && tsd --typings dist/adapters/index.d.ts --files test-d/adapters.test-d.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "gen:component": "tsx scripts/generate-component.ts",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook:test": "test-storybook"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.css",
      "./css": "./dist/index.css",
      "./index.css": "./dist/index.css",
      "./index.wxss": "./dist/index.wxss",
      "./variants": {
        "import": {
          "types": "./dist/variants.d.ts",
          "default": "./dist/variants.js"
        },
        "require": {
          "types": "./dist/variants.d.cts",
          "default": "./dist/variants.cjs"
        }
      },
      "./preset": {
        "import": {
          "types": "./dist/preset.d.ts",
          "default": "./dist/preset.js"
        },
        "require": {
          "types": "./dist/preset.d.cts",
          "default": "./dist/preset.cjs"
        }
      },
      "./components": {
        "import": {
          "types": "./dist/components/index.d.ts",
          "default": "./dist/components/index.js"
        },
        "require": {
          "types": "./dist/components/index.d.cts",
          "default": "./dist/components/index.cjs"
        }
      },
      "./utils": {
        "import": {
          "types": "./dist/utils/index.d.ts",
          "default": "./dist/utils/index.js"
        },
        "require": {
          "types": "./dist/utils/index.d.cts",
          "default": "./dist/utils/index.cjs"
        }
      },
      "./hooks": {
        "import": {
          "types": "./dist/hooks/index.d.ts",
          "default": "./dist/hooks/index.js"
        },
        "require": {
          "types": "./dist/hooks/index.d.cts",
          "default": "./dist/hooks/index.cjs"
        }
      },
      "./adapters": {
        "import": {
          "types": "./dist/adapters/index.d.ts",
          "default": "./dist/adapters/index.js"
        },
        "require": {
          "types": "./dist/adapters/index.d.cts",
          "default": "./dist/adapters/index.cjs"
        }
      }
    },
    "main": "./dist/index.css"
  },
  "peerDependencies": {
    "@tarojs/components": ">=3.0.0",
    "@types/react": ">=16.8.0",
    "react": ">=16.8.0",
    "tailwindcss": "^3.0.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@tarojs/components": { "optional": true },
    "@types/react": { "optional": true },
    "react": {
      "optional": true
    },
    "tailwindcss": { "optional": true }
  },
  "dependencies": {
    "@weapp-tailwindcss/merge": "workspace:*",
    "@weapp-tailwindcss/variants": "workspace:*",
    "tailwind-variants": "catalog:runtimeVariants"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "catalog:storybook",
    "@storybook/react": "catalog:storybook",
    "@storybook/react-vite": "catalog:storybook",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "react": "catalog:react18",
    "react-dom": "catalog:react18",
    "storybook": "catalog:storybook",
    "tailwindcss": "catalog:tailwindcss4",
    "typescript": "catalog:typescript59",
    "vite": "catalog:vite724",
    "weapp-tailwindcss": "workspace:*"
  }
}
