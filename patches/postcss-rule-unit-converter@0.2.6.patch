+declare function remToResponsivePixel(options?: RemBasedPresetOptions): ConversionRule;
+declare function remToViewport(options?: RemToViewportPresetOptions): ConversionRule;
+declare function remToVw(options?: RemToViewportPresetOptions): ConversionRule;
+declare function remToVh(options?: RemToViewportHeightPresetOptions): ConversionRule;
+declare function pxToRem(options?: RemBasedPresetOptions): ConversionRule;
+declare function pxToViewport(options?: ViewportPresetOptions): ConversionRule;
+declare function pxToVw(options?: ViewportPresetOptions): ConversionRule;
+declare function pxToVh(options?: ViewportHeightPresetOptions): ConversionRule;
+declare function rpxToPx(options?: LinearPresetOptions & {
+  ratio?: number;
+}): ConversionRule;
+declare function pxToRpx(options?: LinearPresetOptions & RatioOptions): ConversionRule;
+declare function rpxToRem(options?: RemBasedPresetOptions & RatioOptions): ConversionRule;
+declare function remToRpxRatio(options?: RemBasedPresetOptions & RatioOptions): ConversionRule;
+declare function remToRpxByRatio(options?: RemBasedPresetOptions & RatioOptions): ConversionRule;
+declare function rpxToVw(options?: ViewportPresetOptions & RatioOptions): ConversionRule;
+declare function rpxToVh(options?: ViewportHeightPresetOptions & RatioOptions): ConversionRule;
+declare function vwToPx(options?: ViewportPresetOptions): ConversionRule;
+declare function vhToPx(options?: ViewportHeightPresetOptions): ConversionRule;
+declare function vwToRem(options?: RemToViewportPresetOptions): ConversionRule;
+declare function vhToRem(options?: RemToViewportHeightPresetOptions): ConversionRule;
+declare function vwToRpx(options?: ViewportPresetOptions & RatioOptions): ConversionRule;
+declare function vhToRpx(options?: ViewportHeightPresetOptions & RatioOptions): ConversionRule;
+declare function unitsToPx(options?: UnitMapPresetOptions): ConversionRule[];
+/**
+ * Common preset group that normalizes `px/rem/vw/vh` into `rpx`.
+ */
+declare function rpxPresetGroup(options?: RpxPresetGroupOptions): ConversionRule[];
+/**
+ * Common preset group that normalizes `rem/rpx/vw/vh` into `px`.
+ */
+declare function pxPresetGroup(options?: PxPresetGroupOptions): ConversionRule[];
+/**
