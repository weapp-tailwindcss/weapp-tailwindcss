@@ -0,0 +1,10 @@
+let pluginPath
+try {
+  // Webpack 5.112 将该内部插件移至 optimize；其余模块使用公开导出。
+  pluginPath = require.resolve('webpack/lib/optimize/FlagEntryExportAsUsedPlugin')
+} catch (error) {
+  if (error.code !== 'MODULE_NOT_FOUND') throw error
+  pluginPath = require.resolve('webpack/lib/FlagEntryExportAsUsedPlugin')
+}
+// 加载错误必须原样传播，不能误判为旧版本路径。
+module.exports = require(pluginPath)
