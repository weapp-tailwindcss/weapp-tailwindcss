diff --git a/dist/statefulHmrCommonjs.mjs b/dist/statefulHmrCommonjs.mjs
new file mode 100644
--- /dev/null
+++ b/dist/statefulHmrCommonjs.mjs
@@ -0,0 +1,27 @@
+import babelPresetEnv from '@babel/preset-env'
+import { transformSync } from '@weapp-vite/ast/babelCore'
+
+/** 将原生 DevEngine 的 ESM chunk 转成宿主 CJS，保留原生生成的模块图协议。 */
+export function createStatefulHmrCommonjsPlugin() {
+  return {
+    name: 'weapp-vite:stateful-hmr-commonjs',
+    renderChunk: {
+      order: 'post',
+      handler(code, chunk, options = {}) {
+        const result = transformSync(code, {
+          babelrc: false,
+          configFile: false,
+          filename: chunk.fileName,
+          sourceType: 'module',
+          presets: [[babelPresetEnv, { targets: { node: '22' }, modules: 'commonjs' }]],
+          sourceFileName: chunk.fileName,
+          sourceMaps: Boolean(options.sourcemap),
+        })
+        if (!result?.code) {
+          throw new Error('stateful HMR 宿主 CJS 转换未返回产物。')
+        }
+        return { code: result.code, map: result.map ?? null }
+      },
+    },
+  }
+}
